{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "compendium",
      "displayName": "Compendium (managed toolchain, Debug)",
      "description": "Preferred local development preset using the compendium-managed Clang/libc++ toolchain.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_C_COMPILER": "$env{CC}",
        "CMAKE_CXX_COMPILER": "$env{CXX}",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      },
      "environment": {
        "CXXFLAGS": "$penv{CXXFLAGS}",
        "LDFLAGS": "$penv{LDFLAGS}",
        "LIBRARY_PATH": "$penv{LIBRARY_PATH}",
        "LD_LIBRARY_PATH": "$penv{LD_LIBRARY_PATH}",
        "VCPKG_INSTALLED_DIR": "$penv{VCPKG_INSTALLED_DIR}"
      }
    },
    {
      "name": "compendium-debug",
      "displayName": "Compendium Debug (sanitizers)",
      "description": "Compendium toolchain with AddressSanitizer + UBSan enabled.",
      "inherits": "compendium",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "compendium-release",
      "displayName": "Compendium Release",
      "inherits": "compendium",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "devcontainer",
      "displayName": "DevContainer (Debian x64, Clang 16)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "/opt/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "linux",
      "displayName": "Native Linux (Clang)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (DevContainer, GCC 12)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-coverage",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "/opt/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_C_COMPILER": "gcc-12",
        "CMAKE_CXX_COMPILER": "g++-12",
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "compendium", "configurePreset": "compendium" },
    { "name": "compendium-debug", "configurePreset": "compendium-debug" },
    { "name": "compendium-release", "configurePreset": "compendium-release" }
  ],
  "testPresets": [
    {
      "name": "compendium",
      "configurePreset": "compendium",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "compendium-debug",
      "configurePreset": "compendium-debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
