{
    "name": "WordNebula",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "args": {
            "USERNAME": "vscode",
            "USER_UID": "1000",
            "USER_GID": "1000"
        }
    },

    // Post-create command (minimal - just set up git hooks)
    "postCreateCommand": "pre-commit install --install-hooks || true",

    // Configure tool-specific properties
    "customizations": {
        "vscode": {
            "extensions": [
                "aaron-bond.better-comments",
                "oderwat.indent-rainbow",
                "xaver.clang-format",
                "notskm.clang-tidy",
                "cschlosser.doxdocgen",
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "twxs.cmake",
                "jeff-hykin.better-cpp-syntax",
                "matepek.vscode-catch2-test-adapter",
                "hbenl.vscode-test-explorer",
                "github.vscode-github-actions",
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "eamodio.gitlens",
                "albert.TabOut",
                "vscode-icons-team.vscode-icons",
                "PKief.material-icon-theme",
                "miguelsolorio.fluent-icons",
                "astro-build.houston",
                "bpruitt-goddard.mermaid-markdown-syntax-highlighting",
                "bierner.markdown-mermaid",
                "yzhang.markdown-all-in-one",
                "Anthropic.claude-code"
            ],
            "settings": {
                "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
                "C_Cpp.codeAnalysis.clangTidy.enabled": true,
                "C_Cpp.codeAnalysis.clangTidy.runAutomatically": true,
                "C_Cpp.intelliSenseEngine": "default",
                "C_Cpp.default.compilerPath": "/usr/bin/clang++",
                "C_Cpp.default.cppStandard": "c++20",
                "C_Cpp.default.intelliSenseMode": "linux-clang-arm64",
                "cmake.configureOnOpen": false,
                "cmake.buildBeforeRun": true,
                "cmake.generator": "Ninja",
                "cmake.cmakePath": "/usr/bin/cmake",
                "editor.formatOnSave": true,
                "editor.formatOnPaste": false,
                "files.trimTrailingWhitespace": true,
                "files.insertFinalNewline": true,
                "files.trimFinalNewlines": true,
                "testExplorer.useNativeTesting": true,
                "terminal.integrated.defaultProfile.linux": "zsh",
                "terminal.integrated.profiles.linux": {
                    "zsh": {
                        "path": "/bin/zsh"
                    }
                }
            }
        }
    },

    // Mounts for performance and persistence
    "mounts": [
        // Cache mount for ccache
        "source=wordnebula-ccache,target=/workspace/.ccache,type=volume",
        // Cache mount for vcpkg
        "source=wordnebula-vcpkg-cache,target=/opt/vcpkg/downloads,type=volume"
    ],

    // Features for additional functionality
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "installOhMyZsh": false,
            "upgradePackages": false
        }
    },

    // Container environment variables
    "containerEnv": {
        "VCPKG_ROOT": "/opt/vcpkg",
        "CCACHE_DIR": "/workspace/.ccache",
        "CC": "clang",
        "CXX": "clang++"
    },

    // Forward ports if needed
    "forwardPorts": [],

    // Run as non-root user
    "remoteUser": "vscode",

    // Container user
    "containerUser": "vscode",

    // Update remote user UID/GID to match local user (helps with permissions)
    "updateRemoteUserUID": true,

    // Lifecycle scripts
    "onCreateCommand": "echo '🚀 wordNebula development container created!'",
    "updateContentCommand": "echo '📦 Content updated'",

    // Shutdown action
    "shutdownAction": "stopContainer"
}
